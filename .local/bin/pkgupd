#!/bin/bash
set -euo pipefail

HOMEBREW_ONLY=0

usage() {
    cat <<'EOF'
Usage: pkgupd [--homebrew-only]

Update verifiable Homebrew release assets published at least 7 days ago.
Candidates without publication evidence are reported and left unchanged.
Ubuntu/Debian system packages are updated immediately unless --homebrew-only is used.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --homebrew-only)
            HOMEBREW_ONLY=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Error: Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

# Run each manager in its own shell: failures stop that manager, while the
# parent still runs the other one. Do not call these functions in an if/||
# condition, which would disable errexit inside the function.
update_homebrew() (
    set -e
    command -v brew >/dev/null 2>&1 || { echo "Error: Homebrew not found." >&2; exit 1; }
    command -v python3 >/dev/null 2>&1 || { echo "Error: Python 3 is required." >&2; exit 1; }
    local repo_root
    repo_root=$(python3 -I -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().parents[2])' "$0")
    cd "$repo_root"
    TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/pkgupd.XXXXXX")
    trap 'rm -rf "$TMP_ROOT"' EXIT
    echo "Updating Homebrew metadata..."
    brew update
    export HOMEBREW_NO_AUTO_UPDATE=1
    brew outdated --json=v2 > "$TMP_ROOT/outdated.json"
    local ELIGIBLE=$TMP_ROOT/eligible.tsv
    PYTHONDONTWRITEBYTECODE=1 python3 "$repo_root/scripts/homebrew_release_age.py" "$TMP_ROOT/outdated.json" > "$ELIGIBLE"

    formulae=()
    casks=()
    while IFS=$'\t' read -r kind name; do
        case "$kind" in
            formula) formulae+=("$name") ;;
            cask) casks+=("$name") ;;
        esac
    done < "$ELIGIBLE"

    if [ "${#formulae[@]}" -gt 0 ]; then
        HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 brew upgrade --formula "${formulae[@]}"
    fi
    if [ "${#casks[@]}" -gt 0 ]; then
        HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 brew upgrade --cask "${casks[@]}"
    fi
    if [ "${#formulae[@]}" -eq 0 ] && [ "${#casks[@]}" -eq 0 ]; then
        echo "No Homebrew packages are eligible for upgrade."
    fi
    brew cleanup
)

update_apt() (
    set -e
    command -v apt-get >/dev/null 2>&1 || {
        echo "Error: Linux package updates require apt-get." >&2
        exit 1
    }
    echo "Updating Ubuntu/Debian packages without a cooldown..."
    sudo apt-get update
    sudo apt-get upgrade -y
    sudo apt-get autoremove -y
    sudo apt-get autoclean
)

set +e
update_homebrew
homebrew_status=$?
apt_status=0
if [ "$HOMEBREW_ONLY" -eq 0 ] && [ "$(uname -s)" = "Linux" ]; then
    update_apt
    apt_status=$?
fi
set -e

if [ "$homebrew_status" -ne 0 ] || [ "$apt_status" -ne 0 ]; then
    printf 'Package updates failed: Homebrew=%s APT=%s\n' "$homebrew_status" "$apt_status" >&2
    exit 1
fi
