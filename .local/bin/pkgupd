#!/bin/bash
set -euo pipefail

TOOLS_ONLY=0

usage() {
    cat <<'EOF'
Usage: pkgupd [--tools-only]

Install the versions pinned in the managed mise lockfile.
Ubuntu/Debian system packages are updated unless --tools-only is used.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --tools-only)
            TOOLS_ONLY=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Error: Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

script_source=${BASH_SOURCE[0]}
if [ -L "$script_source" ]; then
    link_target=$(readlink "$script_source")
    case "$link_target" in
        /*) script_source=$link_target ;;
        *) script_source=$(dirname "$script_source")/$link_target ;;
    esac
fi
REPO_ROOT=$(cd "$(dirname "$script_source")/../.." && pwd)

export PATH="$HOME/.local/bin:$PATH"
"$REPO_ROOT/scripts/install-mise.sh"
command -v mise >/dev/null 2>&1 || {
    echo "Error: mise not found. Run $REPO_ROOT/setup.sh first." >&2
    exit 1
}

echo "Installing locked mise tools..."
(cd "$REPO_ROOT" && mise install --locked)

if [ "$TOOLS_ONLY" -eq 0 ] && [ "$(uname -s)" = "Linux" ]; then
    command -v apt-get >/dev/null 2>&1 || {
        echo "Error: Linux package updates require apt-get." >&2
        exit 1
    }
    echo "Updating Ubuntu/Debian system packages..."
    sudo apt-get update
    sudo apt-get upgrade -y
    sudo apt-get autoremove -y
    sudo apt-get autoclean
fi
